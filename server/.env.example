# Copy to .env and fill in real values. Never commit .env.
PORT=9999
NODE_ENV=development

# MongoDB connection string (Atlas or local mongod)
MONGO_URI=mongodb://127.0.0.1:27017/express_boilerplate

# Auth secrets — generate with `openssl rand -base64 64`
JWT_SECRET=change-me-to-a-long-random-string
# Optional: separate secret for refresh tokens (falls back to JWT_SECRET)
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
# Token lifetimes (anything the `ms` package parses: 15m, 1h, 7d)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Must be the exact frontend origin (no trailing slash, no path).
# Server CORS uses this with credentials:true; the frontend must
# also send fetch/axios requests with credentials: "include".
FRONTEND_URL=http://localhost:3000

# Optional: parent cookie domain for cross-subdomain auth in prod
# (e.g. .example.com). Leave unset for localhost.
COOKIE_DOMAIN=

# bcrypt cost factor (12 is a good default; lower for tests)
BCRYPT_SALT_ROUNDS=12

# Log level (debug, info, warn, error). Defaults to debug locally, info in prod.
LOG_LEVEL=debug
# Optional: also persist JSON logs to a file (point a shipper at it).
# LOG_FILE=logs/app.log
